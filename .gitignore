# ============================================================
# product-data-toolkit .gitignore（根目录）
# 原则：源码 / 脚本 / 说明 / 空白模板 进库；
#       凭据、数据、运行产物、缓存、虚拟环境 一律挡在外面。
# 说明：根目录这一份对「本目录及所有子目录」生效。
# ============================================================

# ---------- 凭据（最高优先级：泄露即他人可顶替你登录）----------
session.json
last_run.json
token.txt
*.token
*.pat
.env
.env.*
# 明文口令文件：绝不进版本库，改用环境变量
*password*
*secret*

# ---------- Python 虚拟环境 ----------
.venv/
venv/
env/
.conda/

# ---------- Python 缓存 ----------
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.Python
pip-wheel-metadata/

# ---------- 日志 / 调试产物 ----------
*.log
failed/
_*.out
_*.err
_*.html

# ---------- 备份 / 缓存二进制 ----------
*.bak
*.bak2
*.pkl
.sap_cache/

# ---------- 空目录占位 ----------
.gitkeep

# ---------- 运行结果（可重新生成）----------
**/output/*
!**/output/.gitkeep

# ---------- 业务数据（体积大 + 含商业信息，绝不进库）----------
# 客户商品导入表
sku_matcher/imports/**/*.xlsx
sku_matcher/imports/*.xlsx
!sku_matcher/imports/商品导入模板*.xlsx
!sku_matcher/imports/**/商品导入模板*.xlsx
!sku_matcher/imports/商品导入模板*副本*.xlsx
# SAP 全量导出
sku_matcher/data_source/A006*.xlsx
# 待匹配原始货号清单
sku_matcher/input/**/*.xlsx
sku_matcher/input/*.xlsx
!sku_matcher/input/商品导入模板*.xlsx
# 分类树 / 待分类源表 / 主数据库
product_classifier/data/*.xlsx
product_classifier/input/*
product_classifier/master/*
!product_classifier/input/.gitkeep
# 上传成功后的备份台账
imported/**
# 登录态快照 / 浏览器抓取产物
upload_products_cn/legacy/calibrate/

# ---------- 编辑器 / 系统杂项 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
